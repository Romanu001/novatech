  <script>
/* ===== 全局工具 ===== */

// 当前登录用户（localStorage 模拟）
function getCurrentUser() {
  try {
    const raw = localStorage.getItem("ps_user");
    return raw ? JSON.parse(raw) : null;
  } catch (e) {
    return null;
  }
}

function setCurrentUser(user) {
  if (user) localStorage.setItem("ps_user", JSON.stringify(user));
  else localStorage.removeItem("ps_user");
}

function getUsers() {
  try {
    return JSON.parse(localStorage.getItem("ps_users") || "[]");
  } catch (e) {
    return [];
  }
}

function saveUsers(users) {
  localStorage.setItem("ps_users", JSON.stringify(users));
}

/* ===== 顶部导航栏 ===== */

function renderNavUser() {
  var user = getCurrentUser();
  var chip = document.getElementById("navUser");
  if (!chip) return;
  if (user) {
    chip.classList.add("show");
    var nameEl = chip.querySelector(".user-name");
    if (nameEl) nameEl.textContent = user.name || user.email;
  } else {
    chip.classList.remove("show");
  }
}

document.addEventListener("DOMContentLoaded", function () {
  renderNavUser();

  // 移动端菜单
  var toggle = document.querySelector(".nav-toggle");
  var links = document.querySelector(".nav-links");
  if (toggle && links) {
    toggle.addEventListener("click", function () {
      links.classList.toggle("open");
    });
  }

  // 退出登录
  var logoutBtn = document.getElementById("logoutBtn");
  if (logoutBtn) {
    logoutBtn.addEventListener("click", function () {
      setCurrentUser(null);
      renderNavUser();
      window.location.href = "index.html";
    });
  }
});

/* ===== 登录 / 注册页 ===== */

function isLoginPage() {
  return !!document.getElementById("loginForm");
}

function getFormMode() {
  return document.body.dataset.mode || "login";
}

function toggleMode(mode) {
  var loginCard = document.getElementById("loginCard");
  var registerCard = document.getElementById("registerCard");
  var cardTitle = document.getElementById("authTitle");
  var cardSub = document.getElementById("authSub");

  if (mode === "register") {
    if (loginCard) loginCard.style.display = "none";
    if (registerCard) registerCard.style.display = "block";
    if (cardTitle) cardTitle.textContent = "创建账号";
    if (cardSub) cardSub.textContent = "注册后即可下载我们的 App";
  } else {
    if (loginCard) loginCard.style.display = "block";
    if (registerCard) registerCard.style.display = "none";
    if (cardTitle) cardTitle.textContent = "欢迎回来";
    if (cardSub) cardSub.textContent = "登录以继续使用我们的产品";
  }
}

function showMsg(msg, type) {
  var el = document.getElementById("formMsg");
  if (!el) return;
  el.textContent = msg;
  el.className = "form-msg show " + (type || "err");
}

function validateEmail(email) {
  return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
}

// 登录处理
function handleLogin(event) {
  event.preventDefault();
  var email = document.getElementById("loginEmail").value.trim();
  var password = document.getElementById("loginPassword").value;
  var msg = document.getElementById("loginMsg");

  if (!email || !password) {
    msg.textContent = "请输入邮箱和密码";
    msg.className = "form-msg show err";
    return;
  }

  var users = getUsers();
  var user = users.find(function (u) {
    return u.email === email && u.password === password;
  });

  if (!user) {
    msg.textContent = "邮箱或密码错误，请重试";
    msg.className = "form-msg show err";
    return;
  }

  setCurrentUser({ name: user.name, email: user.email });
  msg.textContent = "登录成功，正在跳转…";
  msg.className = "form-msg show ok";
  setTimeout(function () {
    window.location.href = "index.html";
  }, 800);
}

// 注册处理
function handleRegister(event) {
  event.preventDefault();
  var name = document.getElementById("regName").value.trim();
  var email = document.getElementById("regEmail").value.trim();
  var password = document.getElementById("regPassword").value;
  var confirm = document.getElementById("regConfirm").value;
  var msg = document.getElementById("registerMsg");

  if (!name || !email || !password || !confirm) {
    msg.textContent = "请填写所有字段";
    msg.className = "form-msg show err";
    return;
  }
  if (!validateEmail(email)) {
    msg.textContent = "请输入有效的邮箱地址";
    msg.className = "form-msg show err";
    return;
  }
  if (password.length < 6) {
    msg.textContent = "密码至少需要 6 位";
    msg.className = "form-msg show err";
    return;
  }
  if (password !== confirm) {
    msg.textContent = "两次输入的密码不一致";
    msg.className = "form-msg show err";
    return;
  }

  var users = getUsers();
  if (users.some(function (u) { return u.email === email; })) {
    msg.textContent = "该邮箱已被注册";
    msg.className = "form-msg show err";
    return;
  }

  users.push({ name: name, email: email, password: password });
  saveUsers(users);
  setCurrentUser({ name: name, email: email });
  msg.textContent = "注册成功，正在登录…";
  msg.className = "form-msg show ok";
  setTimeout(function () {
    window.location.href = "index.html";
  }, 800);
}

/* ===== 联系表单 ===== */

function handleContact(event) {
  event.preventDefault();
  var name = document.getElementById("contactName").value.trim();
  var email = document.getElementById("contactEmail").value.trim();
  var message = document.getElementById("contactMessage").value.trim();
  var msg = document.getElementById("contactMsg");

  if (!name || !email || !message) {
    msg.textContent = "请填写完整的联系信息";
    msg.className = "form-msg show err";
    return;
  }
  if (!validateEmail(email)) {
    msg.textContent = "请输入有效的邮箱地址";
    msg.className = "form-msg show err";
    return;
  }

  msg.textContent = "提交成功！我们会尽快与您联系。";
  msg.className = "form-msg show ok";
  event.target.reset();
}

/* ===== 下载链接（可替换为真实地址） ===== */

function bindDownloadLinks() {
  document.querySelectorAll("[data-download]").forEach(function (btn) {
    btn.addEventListener("click", function (e) {
      e.preventDefault();
      var target = btn.getAttribute("data-download");
      // 占位提示：请将 href 替换为真实下载地址
      var msg = document.getElementById("downloadTip");
      if (msg) {
        msg.textContent = "即将开始下载「" + target + "」版本…";
        msg.className = "form-msg show ok";
        setTimeout(function () {
          msg.className = "form-msg";
        }, 4000);
      }
    });
  });
}

if (isLoginPage()) {
  document.addEventListener("DOMContentLoaded", function () {
    var loginForm = document.getElementById("loginForm");
    var registerForm = document.getElementById("registerForm");
    var switchToRegister = document.getElementById("switchToRegister");
    var switchToLogin = document.getElementById("switchToLogin");

    if (loginForm) loginForm.addEventListener("submit", handleLogin);
    if (registerForm) registerForm.addEventListener("submit", handleRegister);
    if (switchToRegister) switchToRegister.addEventListener("click", function (e) { e.preventDefault(); toggleMode("register"); });
    if (switchToLogin) switchToLogin.addEventListener("click", function (e) { e.preventDefault(); toggleMode("login"); });

    // 初始模式
    if (getFormMode() === "register") toggleMode("register");
  });
}

if (document.getElementById("contactForm")) {
  document.getElementById("contactForm").addEventListener("submit", handleContact);
}

document.addEventListener("DOMContentLoaded", function () {
  bindDownloadLinks();
});

</script>
